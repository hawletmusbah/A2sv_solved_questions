class Solution:
    def longestSubarray(self, nums: List[int]) -> int:
        res= 0
        count ={}
        l = 0
        k = 1
        for r in range(len(nums)):
            count[nums[r]] = 1+ count.get(nums[r] ,0)
           
            
            m_frq = count.get(1 ,0)


            if r -l +1 - m_frq > k :
                count[nums[l]] -= 1
                l += 1
            res = max(res, r -l +1)
           
        
        return res - 1

        
